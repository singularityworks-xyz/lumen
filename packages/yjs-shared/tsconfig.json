{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "noEmit": true,
    "types": ["node", "bun-types"],
    "noUncheckedSideEffectImports": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
