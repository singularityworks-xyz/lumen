    "bun-types": "^1.3.12",
    "prisma": "^7.7.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@prisma/instrumentation": "^7.7.0",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.28",
    "pg": "^8.20.0",
    "prismabox": "^1.1.26"
  }
