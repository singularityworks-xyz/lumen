{
  "name": "@lumen/db",
  "version": "1.0.14",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures/*": "./src/fixtures/*",
    "./scripts/*": "./src/scripts/*",
    "./setup/*": "./src/setup/*"
  },
  "scripts": {
