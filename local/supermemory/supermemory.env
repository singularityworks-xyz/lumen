# Lumen local Supermemory server — static config (safe to commit).
# Secrets are NOT stored here; they come from the gitignored root .env
# (GENERALCOMPUTE_API_KEY, GEMINI_API_KEY, SUPERMEMORY_API_KEY) and override
# these values. The docker compose service interpolates them via
# `docker compose --env-file .env` (see scripts/dev/infra.sh).
#
# Docs:
#   https://supermemory.ai/docs/self-hosting/configuration
#   https://supermemory.ai/docs/self-hosting/embeddings

# LLM provider for memory extraction (summaries, contextual chunking).
# Supermemory accepts any OpenAI-compatible endpoint — we point it at
# GeneralCompute (the same provider used for chat). API key comes from
# root .env as GENERALCOMPUTE_API_KEY.
OPENAI_BASE_URL=https://api.generalcompute.com/v1
OPENAI_MODEL=deepseek-v3.1

# Custom embedder: Google Gemini (gemini-embedding-2, 1024 dims — pgvector
# caps at 2000, so the model's full 3072 dims are not supported). API key
# comes from root .env as GEMINI_API_KEY.
SUPERMEMORY_EMBEDDING_PROVIDER=gemini
SUPERMEMORY_EMBEDDING_MODEL=gemini-embedding-2
SUPERMEMORY_EMBEDDING_DIMENSIONS=1024

# Where the embedded graph engine keeps its data.
# The Docker image sets SUPERMEMORY_DATA_DIR=/data itself; run.sh (direct
# launch) defaults to ./supermemory/.supermemory and honours a user override.
# Not set here so the wrong path never leaks into either runner.

# The API key the server prints on first boot is auto-synced into the root
# .env by `bun run infra:up` — nothing to do manually.
#   SUPERMEMORY_API_URL=http://localhost:6767
#   SUPERMEMORY_API_KEY=sm_...
