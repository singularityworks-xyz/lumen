{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lumen-singularityworks",
  "version": "0.0.1",
  "identifier": "com.itssingularity.lumen",
  "build": {
    "beforeDevCommand": "cd ../web && bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd ../web && bun run build",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Lumen by Singularity Works",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
