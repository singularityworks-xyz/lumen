{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lumen-singularityworks",
  "version": "0.0.9",
  "identifier": "com.itssingularity.lumen",
  "build": {
    "beforeDevCommand": "cd ../web && bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd ../web && npx next build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Lumen by Singularity Works",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3002 ws://localhost:3002 https://* wss://*; img-src 'self' asset: https://*; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["lumen"]
      }
    }
  }
}
