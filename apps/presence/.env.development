PORT=4000
REDIS_URL=redis://127.0.0.1:16379
BETTER_AUTH_URL=http://127.0.0.1:3002
WORKERS_API_URL=http://127.0.0.1:3002
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:15080
OPENOBSERVE_USER=root@lumen.dev
OPENOBSERVE_PASSWORD=lumen
OPENOBSERVE_ORG=default
OPENOBSERVE_LOG_STREAM=lumen_presence_logs
OPENOBSERVE_METRIC_STREAM=lumen_presence_metrics
OPENOBSERVE_TRACE_STREAM=lumen_presence_traces
ELIXIR_ERL_OPTIONS=+fnu
LANG=C.UTF-8

# Internal API key for the presence query routes; the workers dev env must
# use the same value so its HTTP fallback authenticates.
INTERNAL_API_KEY=dev-internal-key
