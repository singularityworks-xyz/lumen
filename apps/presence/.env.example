# Presence Service Environment Variables
# Copy this file to .env and fill in your actual values

# ==========================================
# Server Configuration
# ==========================================

# Port to run the presence service on (default: 4000)
PORT=4000

# Enable Phoenix server (set to true for production)
# PHX_SERVER=true

# Host for URL generation (production only)
# PHX_HOST=presence.yourdomain.com

# Secret key base for signing/encrypting
# Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=your-secret-key-base-here

# ==========================================
# Redis Configuration (Upstash)
# ==========================================

# Upstash Redis credentials (recommended for production)
UPSTASH_REDIS_HOST=your-host.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=your-upstash-password

# Alternative: Standard Redis (for local development)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ==========================================
# JWT Authentication
# ==========================================

# JWT secret for token verification
# Use your Better Auth secret here
JWT_SECRET=your-jwt-secret-here

# Alternative: Better Auth secret (if different from JWT_SECRET)
# BETTER_AUTH_SECRET=your-better-auth-secret-here

# ==========================================
# OpenTelemetry Configuration
# ==========================================

# OTLP endpoint for traces (default: http://localhost:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# API key for OTLP exporter (if required by your provider)
# OTEL_API_KEY=your-api-key-here

# ==========================================
# Production Only (Optional)
# ==========================================

# DNS cluster query for distributed Erlang (production clustering)
# DNS_CLUSTER_QUERY="_presence._tcp.cluster.local"

# SSL Certificate paths (if using HTTPS directly)
# SOME_APP_SSL_KEY_PATH=/path/to/server.key
# SOME_APP_SSL_CERT_PATH=/path/to/server.crt
