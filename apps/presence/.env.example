PORT=4000
# Enable Phoenix server (production)
# PHX_SERVER=true
# Host for URL generation (production)
# PHX_HOST=presence.yourdomain.com
# Secret key base for signing/encrypting - generate with: mix phx.gen.secret
# SECRET_KEY_BASE=your-secret-key-base-here
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
BETTER_AUTH_URL=http://localhost:3002
WORKERS_API_URL=http://localhost:3002
# OpenTelemetry Configuration (same format as workers)
# Endpoint for traces, logs, and metrics (OTLP gateway)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Headers in comma-separated key=value format (production only)
# OTEL_EXPORTER_OTLP_HEADERS=api-key=your-otel-api-key
# Domain for Dokploy labels (production)
# DOMAIN=yourdomain.com
ELIXIR_ERL_OPTIONS=+fnu
LANG=C.UTF-8
