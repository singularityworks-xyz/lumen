PORT=4000
# Enable Phoenix server (production)
# PHX_SERVER=true
# Host for URL generation (production)
# PHX_HOST=presence.yourdomain.com
# Secret key base for signing/encrypting - mix phx.gen.secret
SECRET_KEY_BASE=your-secret-key-base-here
UPSTASH_REDIS_HOST=your-host.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=your-upstash-password
BETTER_AUTH_URL=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
