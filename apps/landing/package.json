{
  "name": "@lumen/landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite --port 3001",
    "build": "cross-env NODE_ENV=production tsc -b && cross-env NODE_ENV=production vite build",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check-types": "next typegen && tsc --noEmit",
    "preview": "cross-env NODE_ENV=production vite preview"
  },
  "dependencies": {
    "@lumen/logger": "workspace:^",
    "@lumen/trpc": "workspace:^",
    "@tailwindcss/vite": "^4.1.17",
    "cross-env": "^7.0.3",
    "lucide-react": "^0.554.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@lumen/configs": "workspace:^",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
