{
  "name": "@lumen/workers",
  "version": "1.0.79",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development bun run --watch src/index.ts",
    "dev:test": "cross-env NODE_ENV=test bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun --minify",
    "start": "cross-env NODE_ENV=production bun run dist/index.js",
    "start:test": "cross-env NODE_ENV=test bun run dist/index.js",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@lumen/ai": "workspace:^",
    "@lumen/logger": "workspace:^",
    "@lumen/yjs-shared": "workspace:^",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/instrumentation": "^7.8.0",
    "ai": "^6.0.168",
    "better-auth": "^1.6.7",
    "elysia": "^1.4.28",
    "jose": "^6.2.2",
    "lib0": "^0.2.117",
    "prismabox": "^1.1.26",
    "redis": "^5.12.1",
    "supermemory": "^4.25.4",
    "tsdown": "^0.21.10",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@lumen/db": "workspace:^",
    "@t3-oss/env-core": "^0.13.11",
    "bun-types": "^1.3.13",
    "cross-env": "^10.1.0",
    "prisma": "^7.8.0",
    "zod": "^4.3.6"
  }
}
