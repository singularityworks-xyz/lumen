# For local development:
#   - this app's safe dev defaults come from the committed
#     .env.development file (bun loads it automatically)
#   - secrets come from the gitignored repo-root .env (see .env.example),
#     which the server loads via src/env-loader.ts and which overrides the
#     dev defaults
# This file documents every variable the server reads. In production,
# set them all via your orchestrator (Dokploy, etc.) — no file is loaded.
DATABASE_URL=postgresql://user:password@localhost:5432/mydatabase
BETTER_AUTH_SECRET=your-32-char-secret-here
BETTER_AUTH_URL=http://localhost:3002
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000
JWKS_ENCRYPTION_KEY=your-32-char-encryption-key-here
WEB_URL=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:15080
OPENOBSERVE_USER=root@lumen.dev
OPENOBSERVE_PASSWORD=lumen
OPENOBSERVE_ORG=default
OPENOBSERVE_LOG_STREAM=lumen_workers_logs
OPENOBSERVE_METRIC_STREAM=lumen_workers_metrics
OPENOBSERVE_TRACE_STREAM=lumen_workers_traces

GENERALCOMPUTE_API_KEY=your-generalcompute-api-key
REDIS_URL=redis://127.0.0.1:16379
AI_ENCRYPTION_KEY=your-32-char-encryption-key-here
# Shared secret with the presence service; sent as a Bearer token to its
# presence query endpoints (see apps/presence/.env.example INTERNAL_API_KEY)
INTERNAL_API_KEY=
# Long-term memory via a self-hosted Supermemory server (custom Docker image,
# see docker/supermemory.Dockerfile). `bun run infra:up` starts it and
# auto-syncs the server's API key (sm_...) into the root .env.
# Server-side config lives in local/supermemory/supermemory.env (LLM provider +
# gemini-embedding-2 custom embedder); keys come from the root .env.
SUPERMEMORY_API_URL=http://localhost:6767
SUPERMEMORY_API_KEY=your-supermemory-api-key
