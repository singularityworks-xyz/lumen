DATABASE_URL=postgresql://lumen:lumen@127.0.0.1:15432/lumendb
BETTER_AUTH_SECRET=dev-local-better-auth-secret-123456
BETTER_AUTH_URL=http://localhost:3002
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GITHUB_CLIENT_ID=dev-github-client-id
GITHUB_CLIENT_SECRET=dev-github-client-secret
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWKS_ENCRYPTION_KEY=dev-local-jwks-encryption-key-1234
WEB_URL=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:15080
OPENOBSERVE_USER=root@lumen.dev
OPENOBSERVE_PASSWORD=lumen
OPENOBSERVE_ORG=default
OPENOBSERVE_LOG_STREAM=lumen_workers_logs
OPENOBSERVE_METRIC_STREAM=lumen_workers_metrics
OPENOBSERVE_TRACE_STREAM=lumen_workers_traces
AI_ENCRYPTION_KEY=dev-local-ai-encryption-key-123456
REDIS_URL=redis://127.0.0.1:16379

# Shared secret with the presence service (see apps/presence/.env.development)
INTERNAL_API_KEY=dev-internal-key

# Self-hosted Supermemory server (docker compose supermemory service)
SUPERMEMORY_API_URL=http://localhost:6767

# Enables the E2E session bypass (x-e2e-bypass header) for local/e2e runs.
# NEVER set this in production — the bypass is additionally gated on a
# non-production NODE_ENV, but production must not have it.
E2E_ENABLED=true
