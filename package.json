{
  "name": "lumen",
  "version": "0.4.12",
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@changesets/cli": "^2.30.0",
    "@faker-js/faker": "^10.4.0",
    "@happy-dom/global-registrator": "^20.8.7",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.8.7",
    "lefthook": "^1.13.6",
    "lint-staged": "^16.4.0",
    "msw": "^2.12.14",
    "turbo": "^2.8.20",
    "typescript": "^6.0.2",
    "ultracite": "^7.3.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun ultracite fix"
    ]
  },
  "packageManager": "bun@1.3.11",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "postinstall": "bun run db:gen",
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "dev:web": "concurrently --names \"web,workers\" --prefix-colors \"blue,red\" \"cd apps/web && bun run dev\" \"cd apps/workers && bun run dev\"",
    "dev:linux": "concurrently --names \"native,workers\" --prefix-colors \"yellow,red\" \"cd apps/native && bun run dev:linux\" \"cd apps/workers && bun run dev\"",
    "dev:full": "concurrently --names \"web,workers,presence\" --prefix-colors \"blue,red,green\" \"cd apps/web && bun run dev\" \"cd apps/workers && bun run dev\" \"cd apps/presence && mix phx.server\"",
    "otel:up": "docker compose -f local/docker/docker-compose.otel.yml up -d",
    "otel:down": "docker compose -f local/docker/docker-compose.otel.yml down",
    "check": "bash ./scripts/quality/run-check.sh",
    "check:ci": "bash ./scripts/quality/run-check-ci.sh",
    "check:rust": "cd apps/native/src-tauri && cargo fmt --all --check && cargo clippy --all-targets --all-features -- -D warnings",
    "check-types": "turbo run check-types && bunx tsc --noEmit -p scripts/versioning/tsconfig.json",
    "dep:check": "bunx sherif@latest --fix",
    "dep:up": "bunx taze major -w",
    "db:gen": "cd packages/db && bun prisma generate",
    "db:push": "cd packages/db && bun prisma db push",
    "presence:deps": "cd apps/presence && mix deps.get",
    "presence:dev": "cd apps/presence && mix phx.server",
    "presence:build": "cd apps/presence && mix compile",
    "version:autobump": "bun ./scripts/versioning/autobump.ts",
    "version:autobump:cleanup": "bun ./scripts/versioning/autobump.ts --cleanup",
    "test:unit:web": "bun test --preload ./tests/config/web.setup.ts 'apps/web/src/**/*.test.ts'",
    "test:unit:workers": "bun test --preload ./tests/config/workers.setup.ts 'apps/workers/src/**/*.test.ts'",
    "test:unit:packages": "bun test --preload ./tests/config/bun.setup.ts 'packages/*/src/**/*.test.ts'",
    "test:integration:web": "bun test --preload ./tests/config/web.setup.ts 'apps/web/src/**/*.integration.test.ts'",
    "test:integration:workers": "bun test --preload ./tests/config/workers.setup.ts 'apps/workers/src/**/*.integration.test.ts'",
    "test:coverage": "bun test --preload ./tests/config/web.setup.ts 'apps/*/src/**/*.test.ts' 'packages/*/src/**/*.test.ts' --coverage",
    "test:e2e": "bunx playwright test",
    "test:visual": "bunx playwright test -c playwright.visual.config.ts",
    "test:load:ramp": "k6 run load/k6/ws-collab-ramp.js",
    "test:load:soak": "k6 run load/k6/ws-collab-soak.js",
    "test:load:spike": "k6 run load/k6/ws-collab-spike.js"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@vercel/speed-insights",
    "esbuild",
    "lefthook",
    "sharp"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
