{
  "name": "lumen",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check": "turbo run check && pnpm dlx sherif@latest --fix .",
    "check:ci": "biome ci .",
    "check-types": "turbo run check-types",
    "db:start": "docker compose up -d postgres",
    "db:gen": "pnpm --filter @lumen/db db:generate",
    "db:push": "pnpm --filter @lumen/db db:push",
    "db:studio": "pnpm --filter @lumen/db db:studio",
    "validate-env": "pnpm --filter @lumen/db validate-env"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.8.32",
    "lefthook": "^2.0.4",
    "lint-staged": "^16.2.7",
    "turbo": "^2.6.1",
    "ultracite": "6.3.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.24.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm dlx ultracite fix"
    ]
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "next": "^16.0.5",
    "typescript": "^5.9.3"
  }
}
