{
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@changesets/cli": "^3.0.0",
    "@faker-js/faker": "^10.6.0",
    "@happy-dom/global-registrator": "^20.11.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "^1.3.14",
    "caniuse-lite": "^1.0.30001809",
    "cli-table3": "^0.6.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.2",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "turbo": "^2.10.10",
    "typescript": "7.0.2",
    "ultracite": "7.6.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun ultracite fix"
    ]
  },
  "name": "lumen",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "postinstall": "bun run db:gen",
    "prepare": "bun ./scripts/install/prepare.ts",
    "dev": "turbo run dev",
    "infra:up": "bash scripts/dev/infra.sh up",
    "infra:down": "bash scripts/dev/infra.sh down",
    "dev:web": "concurrently --names \"web,workers\" --prefix-colors \"blue,red\" \"cd apps/web && bun run dev\" \"cd apps/workers && bun run dev\"",
    "dev:linux": "concurrently --names \"native,workers\" --prefix-colors \"yellow,red\" \"cd apps/native && bun run dev:linux\" \"cd apps/workers && bun run dev\"",
    "dev:full": "concurrently --names \"web,workers,presence\" --prefix-colors \"blue,red,green\" \"cd apps/web && bun run dev\" \"cd apps/workers && bun run dev\" \"cd apps/presence && mix phx.server\"",
    "check": "bash ./scripts/quality/run-check.sh",
    "check:ci": "bash ./scripts/quality/run-check-ci.sh",
    "check-types": "turbo run check-types && bunx tsc --noEmit -p load/k6/tsconfig.json && bunx tsc --noEmit -p scripts/versioning/tsconfig.json && bunx tsc --noEmit -p tests/tsconfig.json && bunx tsc --noEmit -p tsconfig.json",
    "dep:check": "bunx sherif@latest --fix",
    "dep:up": "bunx taze major -wr",
    "db:gen": "cd packages/db && bun prisma generate",
    "db:push": "bun run --cwd packages/db push",
    "db:push:dev": "bun cross-env DATABASE_URL=postgresql://lumen:lumen@127.0.0.1:15432/lumendb NODE_ENV=development bun run --cwd packages/db push",
    "db:push:test": "bun cross-env DATABASE_URL=postgresql://lumen:lumen@127.0.0.1:15432/lumendb NODE_ENV=test bun run --cwd packages/db push",
    "presence:deps": "cd apps/presence && mix deps.get",
    "presence:dev": "cd apps/presence && mix phx.server",
    "presence:build": "cd apps/presence && mix compile",
    "version:autobump": "bun ./scripts/versioning/autobump.ts",
    "version:autobump:cleanup": "bun ./scripts/versioning/autobump.ts --cleanup",
    "test:unit": "bash ./scripts/testing/run-unit.sh",
    "test:int": "bash ./scripts/testing/run-integration.sh",
    "test:cov": "bash ./scripts/testing/run-coverage.sh",
    "test:cov:report": "bun run scripts/testing/coverage-summary.ts",
    "test:e2e": "bun playwright test -c playwright/playwright.config.ts",
    "test:visual": "bun playwright test -c playwright/playwright.visual.config.ts",
    "test:load:ramp": "k6 run load/k6/ws-collab-ramp.ts",
    "test:load:soak": "k6 run load/k6/ws-collab-soak.ts",
    "test:load:spike": "k6 run load/k6/ws-collab-spike.ts",
    "test:load:convergence": "k6 run load/k6/ws-collab-convergence.ts",
    "generate:k6-fixtures": "bun run packages/yjs-shared/src/scripts/generate-k6-collab-fixtures.ts",
    "seed:e2e-auth": "bun run packages/db/src/scripts/seed-e2e-auth.ts"
  },
  "version": "0.6.70",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "private": true,
  "overrides": {
    "caniuse-lite": "^1.0.30001809",
    "typescript": "^7.0.2",
    "yjs": "^13.6.30"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@vercel/speed-insights",
    "esbuild",
    "lefthook",
    "sharp"
  ]
}
