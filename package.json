{
  "name": "lumen",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check": "turbo run check",
    "dep:check": "pnpm dlx sherif@latest --fix .",
    "dep:up": "pnpm dlx taze major -w",
    "check:ci": "biome ci .",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "lint-staged": "^16.2.7",
    "turbo": "^2.6.3",
    "ultracite": "6.3.4"
  },
  "packageManager": "pnpm@10.25.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm ultracite fix"
    ]
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5"
    },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@vercel/speed-insights",
      "esbuild",
      "lefthook",
      "sharp"
    ]
  },
  "private": true
}
