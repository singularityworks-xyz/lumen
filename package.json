{
  "name": "lumen",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "postinstall": "bun run db:gen",
    "dev": "turbo run dev",
    "check": "ultracite fix",
    "check-types": "turbo run check-types",
    "dep:check": "bunx sherif@latest --fix .",
    "dep:up": "bunx taze major -w",
    "check:ci": "biome ci .",
    "db:gen": "cd packages/db && bun prisma generate",
    "db:push": "cd packages/db && bun prisma db push"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/bun": "^1.3.5",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "lint-staged": "^16.2.7",
    "turbo": "^2.7.0",
    "ultracite": "6.3.4"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@vercel/speed-insights",
    "esbuild",
    "lefthook",
    "sharp"
  ],
  "packageManager": "bun@1.3.4",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun ultracite fix"
    ]
  },
  "private": true
}
