{
  "compilerOptions": {
    "target": "ES2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "types": ["bun", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": true,
    "libReplacement": false,
    "stableTypeOrdering": true
  },
  "include": ["./autobump.ts"]
}
