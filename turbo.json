{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NEXT_PUBLIC_API_URL",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "OPENOBSERVE_ORG",
    "OPENOBSERVE_LOG_STREAM",
    "OPENOBSERVE_METRIC_STREAM",
    "OPENOBSERVE_TRACE_STREAM"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true
    },
    "format": {
      "dependsOn": ["^format"],
      "cache": true
    },
    "check": {
      "dependsOn": ["^check"],
      "cache": true
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "presence#build": {
      "inputs": ["lib/**/*.ex", "config/**/*.exs", "mix.exs", "mix.lock"],
      "outputs": ["_build/**/*"],
      "cache": true
    },
    "presence#dev": {
      "cache": false,
      "persistent": true
    }
  }
}
