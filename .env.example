# ONLY secrets live here. Safe dev defaults stay in the committed per-app
# .env.development files (e.g. apps/workers/.env.development), which bun
# loads automatically. This file overrides them (the workers server loads it
# via src/env-loader.ts; `bun run infra:up` passes it to docker compose via
# --env-file for the supermemory container).
# Precedence: .env (this file) > per-app .env.development defaults.

# GitHub OAuth (required to boot the workers server)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# GeneralCompute (OpenAI-compatible LLM provider for chat + memory extraction)
GENERALCOMPUTE_API_KEY=your-generalcompute-api-key
# Google Gemini (embedding provider for Supermemory: gemini-embedding-2)
GEMINI_API_KEY=your-gemini-api-key