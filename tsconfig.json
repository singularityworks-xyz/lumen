{
  "compilerOptions": {
    "target": "ES2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "bun-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "noUncheckedSideEffectImports": true,
    "libReplacement": false,
    "stableTypeOrdering": true,
    "rootDir": "./",
    "paths": {
      "@lumen/db": ["./packages/db/src/index.ts"],
      "@lumen/db/*": ["./packages/db/src/*"],
      "@lumen/yjs-shared": ["./packages/yjs-shared/src/index.ts"],
      "@lumen/yjs-shared/*": ["./packages/yjs-shared/src/*"],
      "@web/*": ["./apps/web/src/*"],
      "@workers/*": ["./apps/workers/src/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "playwright/**/*.ts"
  ],
  "tsgo": {
    "checkers": 4,
    "builders": 2
  }
}
